{
  "manifest_version": 3,
  "name": "North+ 体验助手",
  "version": "2.4.2",
  "description": "为 North+ 论坛换上 Material 3 界面：深浅色、宽屏、吸顶导航、公告折叠、图片查看器、键盘快捷键等体验优化。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "North+ 体验助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.north-plus.net/*",
        "*://north-plus.net/*",
        "*://*.south-plus.net/*",
        "*://south-plus.net/*",
        "*://*.south-plus.org/*",
        "*://south-plus.org/*",
        "*://*.east-plus.net/*",
        "*://east-plus.net/*",
        "*://*.white-plus.net/*",
        "*://white-plus.net/*",
        "*://*.level-plus.net/*",
        "*://level-plus.net/*",
        "*://*.snow-plus.net/*",
        "*://snow-plus.net/*",
        "*://*.spring-plus.net/*",
        "*://spring-plus.net/*",
        "*://*.summer-plus.net/*",
        "*://summer-plus.net/*",
        "*://*.blue-plus.net/*",
        "*://blue-plus.net/*",
        "*://bbs.imoutolove.me/*"
      ],
      "css": [
        "src/styles/00-tokens.css",
        "src/styles/01-widescreen.css",
        "src/styles/02-base.css",
        "src/styles/03-header.css",
        "src/styles/04-breadcrumb.css",
        "src/styles/05-cards.css",
        "src/styles/06-forum-notice.css",
        "src/styles/07-thread-list.css",
        "src/styles/08-toolbar.css",
        "src/styles/09-read.css",
        "src/styles/10-forms.css",
        "src/styles/11-footer.css",
        "src/styles/12-user-center.css",
        "src/styles/13-dark-content.css",
        "src/styles/14-components.css",
        "src/styles/15-post.css",
        "src/styles/16-settings.css",
        "src/styles/17-dark-fallback.css",
        "src/styles/18-user-center-layout.css",
        "src/styles/19-responsive.css",
        "src/styles/20-quick-reply.css",
        "src/styles/21-rinsp.css",
        "src/styles/22-settings-subpages.css",
        "src/styles/23-wall.css",
        "src/styles/24-user-center-subpages.css"
      ],
      "js": [
        "src/color.js",
        "src/content/00-core.js",
        "src/content/01-prefs.js",
        "src/content/02-pages.js",
        "src/content/03-composer.js",
        "src/content/04-floating.js",
        "src/content/05-lightbox.js",
        "src/content/06-navigation.js",
        "src/content/07-purchase.js",
        "src/content/08-rinsp.js",
        "src/content/99-main.js"
      ],
      "run_at": "document_start"
    }
  ]
}
