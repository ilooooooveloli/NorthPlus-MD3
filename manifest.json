{
  "manifest_version": 3,
  "name": "North+ 体验助手",
  "version": "2.3.0",
  "description": "为 North+ 论坛换上 Material 3 界面：深浅色、宽屏、吸顶导航、公告折叠、图片查看器、键盘快捷键等体验优化。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "North+ 体验助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.north-plus.net/*",
        "*://north-plus.net/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/color.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
